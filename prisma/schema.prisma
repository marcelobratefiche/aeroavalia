generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Submission = a single passenger rating + optional feedback
model Submission {
  id          String   @id @default(cuid())
  displayName String // Google account display name ONLY (never email)
  googleSub   String // Google "sub" id, used only to prevent duplicate rapid-fire submits, never shown
  rating      Int // 1-5
  feedback    String? // optional free text
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([googleSub])
}

// Minimal NextAuth tables (JWT sessions are used, so only what's needed
// for the Prisma adapter's account linking / sign-in bookkeeping)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
